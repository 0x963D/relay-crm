// CHECK constraints and triggers live in the hand-written migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  manager
  teamLead
  agent
  accountant

  @@map("role")
}

enum TeamKind {
  sales
  accounts

  @@map("team_kind")
}

enum LeadStatus {
  new
  assigned
  working
  won
  lost
  dead

  @@map("lead_status")
}

enum WorkStage {
  ready
  contacted
  callBack
  noAnswer

  @@map("work_stage")
}

enum DeadReason {
  duplicate
  wrongNumber
  doNotContact

  @@map("dead_reason")
}

enum IntakeSource {
  metaLeadAds
  webForm
  csv
  manual

  @@map("intake_source")
}

enum IntakeOutcome {
  leadCreated
  attachedToOpenLead
  leadReopened
  linkedToAccount
  suppressedDeadLead
  rejectedNoEmail

  @@map("intake_outcome")
}

enum ActivityKind {
  attempt
  note
  callback
  closure
  intake
  statusChange
  assignment

  @@map("activity_kind")
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  name      String
  roleVersion Int @default(0) @map("role_version")
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(3)
  sessions      AuthSession[]
  authAccounts  AuthAccount[]

  memberships   Membership[]
  leads         Lead[]       @relation("LeadOwner")
  previousLeads Lead[]       @relation("LeadPreviousOwner")
  accounts      Account[]

  @@map("users")
}

model Team {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  kind      TeamKind
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions    AuthSession[]
  accounts    Account[]
  memberships Membership[]
  leads       Lead[]

  @@map("teams")
}

model Membership {
  userId String  @map("user_id") @db.Uuid
  teamId String  @map("team_id") @db.Uuid
  isLead Boolean @default(false) @map("is_lead")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
  @@map("memberships")
}

model Account {
  teamId    String?  @map("team_id") @db.Uuid
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String?  @map("owner_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  lead         Lead?
  intakeEvents IntakeEvent[]
  activities   Activity[]

  @@index([ownerId])
  @@map("accounts")
}

model Lead {
  workHistoryKnown Boolean @default(true) @map("work_history_known")
  contactedAt DateTime? @map("contacted_at") @db.Timestamptz(3)
  lostNote String? @map("lost_note")
  version         Int         @default(0)
  id              String      @id @default(uuid(7)) @db.Uuid
  email           String      @unique
  name            String?
  phone           String?
  status          LeadStatus
  ownerId         String?     @map("owner_id") @db.Uuid
  teamId          String?     @map("team_id") @db.Uuid
  stage           WorkStage?
  callBackAt      DateTime?   @map("call_back_at") @db.Timestamptz(3)
  noAnswerCount   Int?        @map("no_answer_count")
  deadReason      DeadReason? @map("dead_reason")
  accountId       String?     @unique @map("account_id") @db.Uuid
  firstAssignedAt DateTime?   @map("first_assigned_at") @db.Timestamptz(3)
  previousOwnerId String?     @map("previous_owner_id") @db.Uuid
  createdAt       DateTime    @map("created_at") @db.Timestamptz(3)

  owner         User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  previousOwner User?         @relation("LeadPreviousOwner", fields: [previousOwnerId], references: [id], onDelete: SetNull)
  team          Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  account       Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  intakeEvents  IntakeEvent[]
  activities    Activity[]

  @@index([createdAt, id])
  @@index([ownerId, createdAt, id])
  @@index([teamId, createdAt, id])
  @@map("leads")
}

model IntakeEvent {
  id          String        @id @default(uuid(7)) @db.Uuid
  source      IntakeSource
  externalId  String        @map("external_id")
  email       String?
  name        String?
  phone       String?
  campaign    String?
  adSet       String?       @map("ad_set")
  ad          String?
  form        String?
  submittedAt DateTime?     @map("submitted_at") @db.Timestamptz(3)
  receivedAt  DateTime      @map("received_at") @db.Timestamptz(3)
  // json and not jsonb, because the record is kept as received and never queried, and jsonb
  // refuses a NUL escape.
  raw         Json          @db.Json
  outcome     IntakeOutcome
  leadId      String?       @map("lead_id") @db.Uuid
  accountId   String?       @map("account_id") @db.Uuid

  lead       Lead?      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  account    Account?   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  activities Activity[]

  @@unique([source, externalId])
  @@index([leadId])
  @@index([accountId])
  @@map("intake_events")
}

model Activity {
  sequence BigInt @unique @default(autoincrement())
  id            String       @id @default(uuid(7)) @db.Uuid
  kind          ActivityKind
  leadId        String?      @map("lead_id") @db.Uuid
  accountId     String?      @map("account_id") @db.Uuid
  intakeEventId String?      @map("intake_event_id") @db.Uuid
  detail        Json?
  at            DateTime     @db.Timestamptz(3)

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  intakeEvent IntakeEvent? @relation(fields: [intakeEventId], references: [id], onDelete: Restrict)

  @@index([leadId, id])
  @@index([accountId, id])
  @@index([intakeEventId])
  @@map("activities")
}

model AuthSession {
  id            String   @id @db.Uuid
  token         String   @unique
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTeamId String?  @map("current_team_id") @db.Uuid
  currentTeam   Team?    @relation(fields: [currentTeamId], references: [id], onDelete: SetNull)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String   @unique
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("auth_verifications")
}

model AuthRequestLimit {
  windowSeconds Int @default(60) @map("window_seconds")
  key       String   @id
  count     Int
  startedAt DateTime @map("started_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@map("auth_request_limits")
}

model DistributionPreview {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  fingerprint String
  request     Json
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("distribution_previews")
}

model IdempotencyRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  scope       String
  key         String
  operation   String
  requestHash String   @map("request_hash")
  result      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@map("idempotency_records")
}

enum SystemActor {
  intake
  providerWebhook
  reconciler

  @@map("system_actor")
}

enum AuditAction {
  leadWorked
  leadAssigned
  leadReopened
  checkoutCreated
  paymentStateChanged
  paymentReviewClosed
  ledgerPosted
  manualPaymentRecorded
  paymentApproved
  paymentEdited
  receiptRequeued

  @@map("audit_action")
}

enum AuditSubjectType {
  lead
  account
  payment
  ledger

  @@map("audit_subject_type")
}

model AuditLog {
  requestId String @map("request_id") @db.Uuid
  idempotencyId String? @map("idempotency_id") @db.Uuid
  subjectType AuditSubjectType @map("subject_type")
  systemActor SystemActor? @map("system_actor")
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?   @map("actor_id") @db.Uuid
  action    AuditAction
  subjectId String   @map("subject_id") @db.Uuid
  before    Json
  after     Json
  at        DateTime @db.Timestamptz(3)

  @@index([subjectId, id])
  @@map("audit_log")
}


model Payment {
  creationToken String? @map("creation_token") @db.Uuid
  providerFinal Boolean @default(false) @map("provider_final")
  creationPendingUntil DateTime? @map("creation_pending_until") @db.Timestamptz(3)
  version Int @default(0)
  receiptHash String? @map("receipt_hash")
  reference String?
  id String @id @default(uuid(7)) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  amount BigInt
  currency String
  method String @default("card")
  kind String
  status String @default("checkoutCreated")
  recordedById String @map("recorded_by_id") @db.Uuid
  soldById String? @map("sold_by_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(3)
  completedBy String? @map("completed_by")
  reportedAmount BigInt? @map("reported_amount")
  reportedCurrency String? @map("reported_currency")
  reason String?
  nextCheckAt DateTime? @map("next_check_at") @db.Timestamptz(3)
  checkToken String? @map("check_token") @db.Uuid
  sandboxMode String? @map("sandbox_mode")
  @@index([status, nextCheckAt])
  @@index([accountId, createdAt])
  @@map("payments")
}

model LedgerAccount {
  id String @id @default(uuid(7)) @db.Uuid
  accountId String? @map("account_id") @db.Uuid
  kind String
  currency String
  @@unique([accountId, currency])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id String @id @default(uuid(7)) @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid
  at DateTime @db.Timestamptz(3)
  @@map("ledger_transactions")
}

model LedgerLine {
  side String
  id String @id @default(uuid(7)) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  ledgerAccountId String @map("ledger_account_id") @db.Uuid
  amount BigInt
  @@index([transactionId])
  @@index([ledgerAccountId])
  @@map("ledger_lines")
}

model PaymentEvent {
  sequence BigInt @id @default(autoincrement())
  paymentId String @map("payment_id") @db.Uuid
  kind String
  at DateTime @db.Timestamptz(3)
  detail Json
  @@index([paymentId, sequence])
  @@map("payment_events")
}

model WebhookInbox {
  eventId String @id @map("event_id")
  paymentId String @map("payment_id") @db.Uuid
  payloadHash String @map("payload_hash")
  receivedAt DateTime @map("received_at") @db.Timestamptz(3)
  @@map("webhook_inbox")
}

model Outbox {
  recipient String?
  cycleAttempts Int @default(0) @map("cycle_attempts")
  id String @id @default(uuid(7)) @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid
  topic String
  payload Json
  state String @default("pending")
  attempts Int @default(0)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  @@map("outbox")
}

model SandboxCheckout {
  expiresAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + interval '24 hours')")) @map("expires_at") @db.Timestamptz(3)
  id String @id @default(uuid(7)) @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid
  tokenHash String? @unique @map("token_hash")
  amount BigInt
  currency String
  mode String
  status String @default("pending")
  eventId String @unique @default(uuid(7)) @map("event_id") @db.Uuid
  @@map("sandbox_checkouts")
}


model PaymentApproval {
  paymentVersion Int @default(0) @map("payment_version")
  id String @id @default(uuid(7)) @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  approverId String @map("approver_id") @db.Uuid
  roleVersion Int @map("role_version")
  at DateTime @db.Timestamptz(3)
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(3)
  requestId String @map("request_id") @db.Uuid
  @@index([paymentId])
  @@map("payment_approvals")
}
model ReceiptAttempt {
  id String @id @default(uuid(7)) @db.Uuid
  outboxId String @map("outbox_id") @db.Uuid
  number Int
  state String
  reason String?
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  @@unique([outboxId, number])
  @@map("receipt_attempts")
}
model EmailSuppression {
  email String @id
  reason String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("email_suppressions")
}

model PaymentMaker {
  paymentId String @map("payment_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  at DateTime @db.Timestamptz(3)
  @@id([paymentId, userId])
  @@map("payment_makers")
}
