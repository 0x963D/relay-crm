# The app cannot own or alter tables. Only migration and test setup use the owner connection.
DATABASE_URL=postgresql://relay_app:fake-local-app-password@127.0.0.1:54329/relay
MIGRATION_DATABASE_URL=postgresql://relay_owner:fake-local-owner-password@127.0.0.1:54329/relay

# Meta Lead Ads. Leave all four empty to turn the webhook off. Set all four to turn it on.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
# The Graph API version, such as v24.0.
META_GRAPH_VERSION=

# The built-in dev user. Set 1 to act as it under `pnpm dev`. It exists only
# in development-server bundles. A production server refuses this flag.
RELAY_DEV_ACTOR=
# The dev user's role: owner, admin, manager, teamLead, agent or accountant. Empty means agent,
# which sees only its own leads.
RELAY_DEV_ROLE=
# Generate a secret before enabling sign-in. Clear AUTH_SECRET to keep sign-in off.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# This placeholder is deliberately refused at startup.
AUTH_SECRET=example-only-do-not-use-this-secret
AUTH_URL=
# SMTP is required outside development. Without it, pnpm dev prints issued codes locally.
SMTP_URL=
SMTP_FROM=

# Number of trusted proxy hops. 0 ignores X-Forwarded-For and uses the TCP peer.
# With proxies, block direct access and require them to append or overwrite the verified chain.
RELAY_TRUSTED_PROXY_COUNT=0

# Global sign-in circuit breaker per 60 seconds. Each client is separately limited to 20.
RELAY_AUTH_GLOBAL_LIMIT=10000

# Sandbox payments stay disabled unless explicitly enabled.
RELAY_DEMO=
# Demo-only JSON file containing ownerUrl. The app uses it only for a guarded reset.
RELAY_SANDBOX=
RELAY_SANDBOX_URL=
RELAY_PAYMENT_WEBHOOK_SECRET=
RELAY_RECONCILE_SECRET=
RELAY_RECONCILE_FIRST_MS=900000
RELAY_RECONCILE_INTERVAL_MS=300000
RELAY_SANDBOX_LATE_MS=30000

# Protects POST /api/payments/outbox. Receipt delivery uses SMTP_URL and SMTP_FROM.
RELAY_OUTBOX_SECRET=

# A checkout expires after this many milliseconds, 24 hours by default.
RELAY_CHECKOUT_TTL_MS=86400000

RELAY_RECEIPT_LEASE_MS=60000
RELAY_RECEIPT_SEND_TIMEOUT_MS=30000
RELAY_RECEIPT_LIFETIME_ATTEMPTS=12

RELAY_TIME_ZONE=UTC

# Set 0 to answer public lead form submissions with 404. Unset or 1 keeps intake on.
RELAY_PUBLIC_FORM=1
