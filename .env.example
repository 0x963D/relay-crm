# Copy this file to .env. The root scripts load it, and a variable set in your shell wins.

# A PostgreSQL 17 database. The integration tests also create and drop their own databases on
# this server, so the user needs CREATEDB there.
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay

# Meta Lead Ads. Leave all four empty to turn the webhook off. Set all four to turn it on.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
# The Graph API version, such as v24.0.
META_GRAPH_VERSION=

# The built-in dev user, until sign-in exists. Set 1 to act as it under `pnpm dev`. It exists only
# when NODE_ENV is development, which `pnpm dev` sets and `pnpm start` does not.
RELAY_DEV_ACTOR=
# The dev user's role: owner, admin, manager, teamLead, agent or accountant. Empty means agent,
# which sees only its own leads.
RELAY_DEV_ROLE=
