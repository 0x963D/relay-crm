{
  "name": "relay-crm",
  "version": "0.1.0",
  "private": true,
  "description": "A sales CRM for small teams: lead intake, distribution, follow-up and payments.",
  "license": "MIT",
  "author": "Dan Doca",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "dotenv -- pnpm --filter @relay/web dev",
    "build": "pnpm --filter @relay/web build",
    "start": "dotenv -- pnpm --filter @relay/web start",
    "lint": "pnpm --filter @relay/web types:api && node scripts/check-styles.mjs && node scripts/check-docs.mjs && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive typecheck",
    "test": "vitest run --project unit",
    "test:proofs": "node scripts/check-proofs.mjs",
    "test:int": "dotenv -- vitest run --project integration",
    "test:prod": "pnpm build && dotenv -- vitest run --project production",
    "db:generate": "pnpm --filter @relay/store generate",
    "db:migrate": "dotenv -- pnpm --filter @relay/store migrate",
    "db:seed": "dotenv -- tsx apps/web/scripts/seed.ts",
    "demo:reset": "dotenv -- tsx apps/web/scripts/demo-reset.ts",
    "demo:check": "tsx apps/web/scripts/demo-check.ts",
    "test:image": "tsx apps/web/scripts/image-check.ts",
    "outbox": "dotenv -- tsx apps/web/scripts/outbox.ts",
    "reconcile": "dotenv -- tsx apps/web/scripts/reconcile.ts",
    "import:csv": "dotenv -- tsx apps/web/scripts/import-csv.ts",
    "test:mutations": "tsx packages/store/test/safety-mutations.ts",
    "test:browser": "dotenv -- playwright test --grep-invert @capture",
    "capture": "dotenv -- tsx apps/web/scripts/capture.ts",
    "capture:readme": "dotenv -- tsx apps/web/scripts/capture.ts --readme"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "~10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
