{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm db:generate && pnpm build",
  "git": { "deploymentEnabled": false },
  "schedules": {
    "demo-payments": {
      "schedule": "*/15 * * * *",
      "path": "/api/demo/jobs",
      "requestMethod": "POST"
    }
  }
}
